<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <!-- MD3 roles: surface / surface-container / container-high / secondary-container -->
      <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#EEF0F4"/>
      <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#F7F8FB"/>
      <SolidColorBrush x:Key="SurfaceContainerBrush" Color="#EEF0F4"/>
      <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="SecondaryContainerBrush" Color="#DCE0EA"/>
      <SolidColorBrush x:Key="OnSecondaryContainerBrush" Color="#1A1C1E"/>
      <SolidColorBrush x:Key="PrimaryContainerBrush" Color="#CFE5FA"/>
      <SolidColorBrush x:Key="OnPrimaryContainerBrush" Color="#001E33"/>

      <!-- digits / scientific helpers (white tiles on the cool grey surface) -->
      <SolidColorBrush x:Key="ButtonNeutralBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="ButtonNeutralHoverBrush" Color="#DCE3EE"/>
      <SolidColorBrush x:Key="ButtonNeutralPressedBrush" Color="#D2DAE8"/>

      <!-- operations / bitwise / base selectors -->
      <SolidColorBrush x:Key="ButtonOperationBrush" Color="#CBD2E1"/>
      <SolidColorBrush x:Key="ButtonOperationHoverBrush" Color="#C1C9DA"/>
      <SolidColorBrush x:Key="ButtonOperationPressedBrush" Color="#B7C0D4"/>

      <!-- primary + on-primary -->
      <SolidColorBrush x:Key="AccentBrush" Color="#0067C0"/>
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#1975C5"/>
      <SolidColorBrush x:Key="AccentPressedBrush" Color="#3183CA"/>
      <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="AccentSubtleBrush" Color="#E7F1FC"/>

      <!-- error roles -->
      <SolidColorBrush x:Key="ErrorBrush" Color="#B3261E"/>
      <SolidColorBrush x:Key="ErrorContainerBrush" Color="#F6E9E7"/>
      <SolidColorBrush x:Key="OnErrorContainerBrush" Color="#52302B"/>

      <SolidColorBrush x:Key="SelectedBrush" Color="#B2CDEE"/>
      <SolidColorBrush x:Key="OnSelectedBrush" Color="#1A1C1E"/>
      <SolidColorBrush x:Key="SoftAccentBrush" Color="#C6DCF7"/>
      <SolidColorBrush x:Key="OnSoftAccentBrush" Color="#0A3069"/>
      <SolidColorBrush x:Key="TileBorderBrush" Color="#D9DDE5"/>
      <SolidColorBrush x:Key="TileHoverBorderBrush" Color="#9FB0C7"/>
      <SolidColorBrush x:Key="SubtleBorderBrush" Color="#C9CED8"/>
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1C1E"/>
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#565A60"/>
      <SolidColorBrush x:Key="TextDisabledBrush" Color="#5A5F66"/>
      <SolidColorBrush x:Key="DisabledSurfaceBrush" Color="#E4E6EB"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#202020"/>
      <SolidColorBrush x:Key="AppSurfaceBrush" Color="#2F2F33"/>
      <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#2B2B2B"/>
      <SolidColorBrush x:Key="SurfaceContainerBrush" Color="#202020"/>
      <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="#3A3A3D"/>
      <SolidColorBrush x:Key="SecondaryContainerBrush" Color="#4E5157"/>
      <SolidColorBrush x:Key="OnSecondaryContainerBrush" Color="#E8EAED"/>
      <SolidColorBrush x:Key="PrimaryContainerBrush" Color="#0B3A57"/>
      <SolidColorBrush x:Key="OnPrimaryContainerBrush" Color="#CFE5FA"/>

      <SolidColorBrush x:Key="ButtonNeutralBrush" Color="#3A3A3D"/>
      <SolidColorBrush x:Key="ButtonNeutralHoverBrush" Color="#454548"/>
      <SolidColorBrush x:Key="ButtonNeutralPressedBrush" Color="#4C4C50"/>

      <SolidColorBrush x:Key="ButtonOperationBrush" Color="#4E5157"/>
      <SolidColorBrush x:Key="ButtonOperationHoverBrush" Color="#585B62"/>
      <SolidColorBrush x:Key="ButtonOperationPressedBrush" Color="#61646B"/>

      <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF"/>
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#3FB8F5"/>
      <SolidColorBrush x:Key="AccentPressedBrush" Color="#2FA8E0"/>
      <SolidColorBrush x:Key="AccentForegroundBrush" Color="#00344A"/>
      <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1E3A4D"/>

      <SolidColorBrush x:Key="ErrorBrush" Color="#F2B8B5"/>
      <SolidColorBrush x:Key="ErrorContainerBrush" Color="#3E2B29"/>
      <SolidColorBrush x:Key="OnErrorContainerBrush" Color="#F0DAD6"/>

      <SolidColorBrush x:Key="SelectedBrush" Color="#0B3A57"/>
      <SolidColorBrush x:Key="OnSelectedBrush" Color="#CFE5FA"/>
      <SolidColorBrush x:Key="SoftAccentBrush" Color="#104E73"/>
      <SolidColorBrush x:Key="OnSoftAccentBrush" Color="#CFE5FA"/>
      <SolidColorBrush x:Key="TileBorderBrush" Color="#3A3A3D"/>
      <SolidColorBrush x:Key="TileHoverBorderBrush" Color="#6B7280"/>
      <SolidColorBrush x:Key="SubtleBorderBrush" Color="#3A3A3A"/>
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F5F5"/>
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B0B0B0"/>
      <SolidColorBrush x:Key="TextDisabledBrush" Color="#9C9C9E"/>
      <SolidColorBrush x:Key="DisabledSurfaceBrush" Color="#313134"/>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
